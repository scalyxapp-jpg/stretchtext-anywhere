{
	"manifest_version": 3,
	"name": "Stretchtext Anywhere",
	"version": "1.0.0",
	"description": "Select any passage on any page and grow it in place. Click the grown text to shrink it back. Reads are paid from your own Pollen.",
	"permissions": ["storage"],
	"host_permissions": [
		"https://gen.pollinations.ai/*",
		"https://enter.pollinations.ai/*"
	],
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "src/popup.html",
		"default_title": "Stretchtext Anywhere",
		"default_icon": {
			"16": "icons/icon-16.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"exclude_matches": [
				"*://*.youtube.com/*",
				"*://docs.google.com/*",
				"*://mail.google.com/*"
			],
			"js": ["src/core.js", "src/content.js"],
			"css": ["src/content.css"],
			"run_at": "document_idle"
		}
	]
}
